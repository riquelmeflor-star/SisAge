{
  "name": "ceti-agendamento",
  "version": "1.0.0",
  "description": "Sistema de Agendamento CETI Senador José Cândido Ferraz",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/prepare-vercel.js",
    "db:setup": "node --env-file=.env.local scripts/setup-postgres.js",
